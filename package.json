{
  "name": "sirbro-chatbot-widget",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "orchestrator:doctor": "codex-orchestrator doctor --target \"$PWD\"",
    "orchestrator:status": "codex-orchestrator status --target \"$PWD\"",
    "orchestrator:status:json": "codex-orchestrator status --target \"$PWD\"",
    "orchestrator:daemon": "codex-orchestrator doctor --target \"$PWD\" && codex-orchestrator daemon --target \"$PWD\"",
    "orchestrator:daemon:once": "codex-orchestrator doctor --target \"$PWD\" && codex-orchestrator daemon --target \"$PWD\" --once",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "codex-orchestrator": "^2.0.24",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
